@using Microsoft.AspNetCore.Components.Authorization
@using FuncPulse.Web.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAzureCredentialService CredentialService
@inject NavigationManager Navigation

<div class="auth-container">
    @if (CredentialService.IsUserAuthenticated)
    {
        <div class="user-info">
            <i class="bi bi-person-check-fill me-1"></i>
            <span class="user-name">@CredentialService.UserDisplayName</span>
            <a href="MicrosoftIdentity/Account/SignOut" class="btn btn-sm btn-outline-secondary ms-2">
                Sign out
            </a>
        </div>
    }
    else if (ShowLoginButton)
    {
        <div class="login-prompt">
            <a href="MicrosoftIdentity/Account/SignIn" class="btn btn-sm btn-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Sign in with Microsoft
            </a>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool ShowLoginButton { get; set; } = true;
}

<style>
    .auth-container {
        display: flex;
        align-items: center;
        padding: 0.5rem;
    }

    .user-info {
        display: flex;
        align-items: center;
        font-size: 0.9rem;
    }

    .user-name {
        font-weight: 500;
        color: var(--bs-body-color);
    }

    .login-prompt {
        display: flex;
        align-items: center;
    }
</style>
