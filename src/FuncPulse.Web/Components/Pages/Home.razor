@page "/"
@rendermode InteractiveServer
@using FuncPulse.Core.Models
@using FuncPulse.Core.Services
@using FuncPulse.Web.Services
@using Microsoft.Extensions.Options
@using static FuncPulse.Web.Services.TimeDisplayMode
@inject IFunctionDiscoveryService DiscoveryService
@inject IMetricsService MetricsService
@inject IOptions<AzureSettings> AzureSettings
@inject NavigationManager Navigation
@inject DashboardState DashboardState
@inject IFunctionManagementService ManagementService
@inject ILogger<Home> Logger
@inject IAzureCredentialService CredentialService

<PageTitle>FuncPulse - Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>FuncPulse Dashboard</h1>
            @if (AzureSettings.Value.DemoMode)
            {
                <div class="alert alert-info">
                    <strong>Demo Mode:</strong> Showing sample data. Configure Azure credentials to view real functions.
                </div>
            }
            else if (AzureCredentialFactory.IsRunningInAzure() && !CredentialService.IsUserAuthenticated)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Not Signed In:</strong> Sign in with your Microsoft account to view your Azure Function Apps.
                    <a href="MicrosoftIdentity/Account/SignIn" class="btn btn-sm btn-primary ms-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Sign in with Microsoft
                    </a>
                </div>
            }
            else if (CredentialService.IsUserAuthenticated)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Viewing Azure resources with your credentials (@CredentialService.UserDisplayName)
                </div>
            }
        </div>
    </div>

    <div class="row mb-3 align-items-center">
        <div class="col-auto">
            <strong>Subscription:</strong>
        </div>
        <div class="col-auto">
            @if (!AzureSettings.Value.DemoMode && availableSubscriptions.Count > 0)
            {
                <select class="form-select form-select-sm" style="max-width: 400px;" @onchange="OnSubscriptionChanged" value="@subscriptionId">
                    <option value="">-- Select Subscription --</option>
                    @foreach (var sub in availableSubscriptions)
                    {
                        <option value="@sub.SubscriptionId" selected="@(sub.SubscriptionId == subscriptionId)">@sub.DisplayName</option>
                    }
                </select>
                @if (string.IsNullOrEmpty(subscriptionId))
                {
                    <small class="text-muted d-block mt-1">Choose a subscription to load resource groups.</small>
                }
            }
            else
            {
                <span class="text-muted">@(string.IsNullOrEmpty(subscriptionId) ? "Not configured" : subscriptionId)</span>
            }
        </div>
        <div class="col-auto">
            <strong>Resource Group:</strong>
        </div>
        <div class="col-auto">
            @if (!AzureSettings.Value.DemoMode && !string.IsNullOrEmpty(subscriptionId) && availableResourceGroups.Count > 0)
            {
                <select class="form-select form-select-sm" style="max-width: 300px;" @onchange="OnResourceGroupChanged" value="@resourceGroup">
                    <option value="">-- Select Resource Group --</option>
                    @foreach (var rg in availableResourceGroups)
                    {
                        <option value="@rg" selected="@(rg == resourceGroup)">@rg</option>
                    }
                </select>
                @if (string.IsNullOrEmpty(resourceGroup))
                {
                    <small class="text-muted d-block mt-1">Choose a resource group to load its functions.</small>
                }
            }
            else if (!AzureSettings.Value.DemoMode && string.IsNullOrEmpty(subscriptionId))
            {
                <span class="text-muted">Select a subscription first</span>
            }
            else
            {
                <span class="text-muted">@(string.IsNullOrEmpty(resourceGroup) ? "Not configured" : resourceGroup)</span>
            }
        </div>
        <div class="col-auto ms-auto">
            <button type="button" 
                    class="btn btn-sm btn-outline-primary"
                    @onclick="RefreshDataAsync"
                    disabled="@(isDiscovering || isLoading)">
                <i class="bi bi-arrow-clockwise"></i> Refresh Dashboard
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="white-space: pre-line;">
            <strong>Error:</strong> @errorMessage
        </div>
    }
    
    @if (isDiscovering)
    {
        <div class="alert alert-info d-flex align-items-center">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Discovering function apps...</span>
        </div>
    }
    
    @if (!AzureSettings.Value.DemoMode && string.IsNullOrEmpty(subscriptionId))
    {
        <div class="alert alert-info">
            Select a subscription from the dropdown above to begin.
        </div>
    }
    else if (!AzureSettings.Value.DemoMode && string.IsNullOrEmpty(resourceGroup))
    {
        <div class="alert alert-info">
            Select a resource group from the dropdown above to load functions.
        </div>
    }
    else if (!isDiscovering && functionApps.Count == 0 && string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning">
            No function apps found in the configured resource group.
        </div>
    }
    
    @if (functionApps.Count > 0)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">@functionApps.Count</h5>
                        <p class="card-text text-muted">Function Apps</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">@totalFunctions</h5>
                        <p class="card-text text-muted">Total Functions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5 class="card-title">@healthyCount</h5>
                        <p class="card-text">Healthy</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body">
                        <h5 class="card-title">@unhealthyCount</h5>
                        <p class="card-text">Needs Attention</p>
                    </div>
                </div>
            </div>
        </div>

        @foreach (var app in functionApps)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            @app.Name 
                            <span class="badge bg-secondary">@app.Location</span>
                            @if (appStates.TryGetValue(app.ResourceId, out var state))
                            {
                                <span class="badge @GetStateBadgeClass(state)">@state</span>
                            }
                        </h5>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn btn-sm btn-outline-primary"
                                @onclick="() => RefreshSingleAppAsync(app)"
                                disabled="@(appsLoadingMetrics.Contains(app.ResourceId))"
                                title="Refresh this function app">
                            @if (appsLoadingMetrics.Contains(app.ResourceId))
                            {
                                <span class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise"></i>
                            }
                        </button>
                        <div class="btn-group" role="group">
                            @if (canManageApps)
                            {
                                @if (appStates.TryGetValue(app.ResourceId, out var appState))
                                {
                                    @if (appState == FunctionAppState.Running)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-warning"
                                                @onclick="() => RestartAppAsync(app)"
                                                disabled="@(isManaging.Contains(app.ResourceId))">
                                            @if (isManaging.Contains(app.ResourceId))
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-clockwise me-1"></i>
                                            }
                                            Restart
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => StopAppAsync(app)"
                                                disabled="@(isManaging.Contains(app.ResourceId))">
                                            @if (isManaging.Contains(app.ResourceId))
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-stop-circle me-1"></i>
                                            }
                                            Stop
                                        </button>
                                    }
                                    else if (appState == FunctionAppState.Stopped)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-success"
                                                @onclick="() => StartAppAsync(app)"
                                                disabled="@(isManaging.Contains(app.ResourceId))">
                                            @if (isManaging.Contains(app.ResourceId))
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-circle me-1"></i>
                                            }
                                            Start
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            @appState
                                        </button>
                                    }
                                }
                            }
                            else if (!AzureSettings.Value.DemoMode)
                            {
                                <button type="button" 
                                        class="btn btn-sm btn-outline-secondary" 
                                        disabled
                                        title="Insufficient permissions to manage function apps">
                                    <i class="bi bi-lock"></i> Management Disabled
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (app.Functions.Count == 0)
                    {
                        <p class="text-muted">No functions found</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Time Range</label>
                            <div class="btn-group" role="group">
                                @foreach (var range in Enum.GetValues<TimeRange>())
                                {
                                    <button type="button" 
                                            class="btn btn-sm @(selectedTimeRange == range ? "btn-primary" : "btn-outline-primary")"
                                            @onclick="() => SelectTimeRange(range)">
                                        @range.ToDisplayString()
                                    </button>
                                }
                            </div>
                        </div>
                        
                        @if (appsLoadingMetrics.Contains(app.ResourceId))
                        {
                            <div class="alert alert-info d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span>Loading metrics and invocation data...</span>
                            </div>
                        }
                        
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Function</th>
                                        <th>Trigger</th>
                                        <th>Status</th>
                                        <th>Success</th>
                                        <th>Failure</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var function in app.Functions)
                                    {
                                        var metrics = function.Metrics;
                                        var status = (metrics != null && function.RecentInvocations.Count > 0)
                                            ? metrics.GetHealthStatus(function.RecentInvocations)
                                            : (metrics?.GetHealthStatus() ?? HealthStatus.Unknown);
                                        var statusClass = status switch
                                        {
                                            HealthStatus.Healthy => "success",
                                            HealthStatus.Warning => "warning",
                                            HealthStatus.Critical => "danger",
                                            _ => "secondary"
                                        };

                                        <tr>
                                            <td>@GetShortFunctionName(function.Name)</td>
                                            <td><span class="badge bg-info">@function.TriggerType</span></td>
                                            <td>
                                                @if (appsLoadingMetrics.Contains(app.ResourceId))
                                                {
                                                    <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-@statusClass">@status</span>
                                                }
                                            </td>
                                            <td>@(metrics != null ? metrics.SuccessCount.ToString() : "—")</td>
                                            <td>@(metrics != null ? metrics.FailureCount.ToString() : "—")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => ViewFunctionDetails(app, function)">
                                                    Details
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string subscriptionId = string.Empty;
    private string resourceGroup = string.Empty;
    private TimeRange selectedTimeRange = TimeRange.Hours24;
    private List<FunctionAppInfo> functionApps = new();
    private bool isLoading = false;
    private bool isDiscovering = false;
    private string? errorMessage;
    private bool restoredFromState;
    private bool showRefreshPrompt;
    private bool canManageApps = false;
    private Dictionary<string, FunctionAppState> appStates = new();
    private HashSet<string> isManaging = new();
    private string? managementErrorMessage;
    private HashSet<string> appsLoadingMetrics = new();
    
    private List<SubscriptionInfo> availableSubscriptions = new();
    private List<string> availableResourceGroups = new();
    
    private int totalFunctions => functionApps.Sum(a => a.Functions.Count);
    private int healthyCount => functionApps.SelectMany(a => a.Functions)
        .Count(f => {
            var status = (f.Metrics != null && f.RecentInvocations.Count > 0)
                ? f.Metrics.GetHealthStatus(f.RecentInvocations)
                : (f.Metrics?.GetHealthStatus() ?? HealthStatus.Unknown);
            return status == HealthStatus.Healthy;
        });
    private int unhealthyCount => functionApps.SelectMany(a => a.Functions)
        .Count(f => {
            var status = (f.Metrics != null && f.RecentInvocations.Count > 0)
                ? f.Metrics.GetHealthStatus(f.RecentInvocations)
                : (f.Metrics?.GetHealthStatus() ?? HealthStatus.Unknown);
            return status == HealthStatus.Warning || status == HealthStatus.Critical;
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AzureSettings.Value.DemoMode)
            {
                // Demo mode: load function apps directly
                await LoadDataAsync();
            }
            else
            {
                await InitializeAzureAsync();
            }
        }
    }

    private async Task InitializeAzureAsync()
    {
        isDiscovering = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var timeoutSeconds = AzureSettings.Value.OperationTimeoutSeconds;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));
            
            // First, load available subscriptions
            availableSubscriptions = await DiscoveryService.ListSubscriptionsAsync(cts.Token);
            
            if (availableSubscriptions.Count == 0)
            {
                throw new InvalidOperationException("No Azure subscriptions are available for the current credentials.");
            }
            
            // Auto-select first subscription if only one is available
            if (availableSubscriptions.Count == 1)
            {
                subscriptionId = availableSubscriptions[0].SubscriptionId;
                await LoadResourceGroupsAndRestoreStateAsync();
            }
            else
            {
                // Try to restore subscription from state (check all available subscriptions)
                foreach (var sub in availableSubscriptions)
                {
                    if (DashboardState.TryRestore(sub.SubscriptionId, out var _))
                    {
                        subscriptionId = sub.SubscriptionId;
                        await LoadResourceGroupsAndRestoreStateAsync();
                        break;
                    }
                }
                // If no state was restored, wait for user to select a subscription
            }
        }
        catch (OperationCanceledException)
        {
            errorMessage = $"Timed out after {AzureSettings.Value.OperationTimeoutSeconds} seconds while loading Azure subscriptions. Run 'az login' to authenticate.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load Azure subscriptions. Run 'az login' to authenticate. Details: {ex.Message}";
        }
        finally
        {
            isDiscovering = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadResourceGroupsAndRestoreStateAsync()
    {
        if (DashboardState.TryRestore(subscriptionId, out var snapshot))
        {
            resourceGroup = snapshot.ResourceGroup;
            selectedTimeRange = snapshot.SelectedTimeRange;
            availableResourceGroups = snapshot.AvailableResourceGroups.ToList();
            functionApps = snapshot.FunctionApps.ToList();
            restoredFromState = true;
            showRefreshPrompt = snapshot.ShouldPromptForRefresh;

            await LoadResourceGroupsAsync(showLoadingState: false);
            await CheckManagementPermissionsAsync();
            if (canManageApps)
            {
                await LoadAppStatesAsync();
            }
        }
        else
        {
            await LoadResourceGroupsAsync(showLoadingState: false);
        }

        if (!restoredFromState && !string.IsNullOrEmpty(resourceGroup))
        {
            await LoadDataAsync();
        }
    }

    private async Task SelectTimeRange(TimeRange range)
    {
        selectedTimeRange = range;
        await LoadDataAsync();
    }

    private void SetTimeDisplayMode(TimeDisplayMode mode)
    {
        DashboardState.TimeDisplayMode = mode;
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        isDiscovering = true;
        isLoading = false;
        errorMessage = null;
        showRefreshPrompt = false;
        DashboardState.ClearRefreshPrompt();
        functionApps.Clear();
        appsLoadingMetrics.Clear();
        await InvokeAsync(StateHasChanged);

        var timeoutSeconds = AzureSettings.Value.OperationTimeoutSeconds;
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));

        try
        {
            var discoveredApps = await DiscoveryService.DiscoverFunctionAppsAsync(
                subscriptionId, 
                resourceGroup, 
                cts.Token);
            
            isDiscovering = false;
            await InvokeAsync(StateHasChanged);
            
            // Process each app progressively
            var metricsTasks = new List<Task>();
            foreach (var app in discoveredApps)
            {
                cts.Token.ThrowIfCancellationRequested();
                
                // Add app to the list immediately (with empty metrics)
                functionApps.Add(app);
                appsLoadingMetrics.Add(app.ResourceId);
                await InvokeAsync(StateHasChanged);
                
                // Load metrics and invocations for this app
                var metricsTask = LoadAppMetricsAsync(app, selectedTimeRange, cts.Token);
                metricsTasks.Add(metricsTask);
            }
            
            // Wait for all metrics to complete
            await Task.WhenAll(metricsTasks);
            
            // Load management permissions and app states
            await CheckManagementPermissionsAsync();
            if (canManageApps)
            {
                await LoadAppStatesAsync();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            var timestamp = DateTime.Now.ToString("HH:mm:ss");
            Console.WriteLine($"[{timestamp}] FunctionDiscoveryService: TIMEOUT after {timeoutSeconds} seconds");
            Console.WriteLine($"[{timestamp}] FunctionDiscoveryService: This usually indicates slow authentication or network issues");
            errorMessage = $"Operation timed out after {timeoutSeconds} seconds. This usually means:\n" +
                          "• Azure CLI authentication is slow or stale (try: az login --use-device-code)\n" +
                          "• Network connectivity issues to Azure\n" +
                          "• Insufficient permissions on the subscription/resource group\n" +
                          "Check the console output for details on where the operation stalled.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load function apps: {ex.Message}";
        }
        finally
        {
            isDiscovering = false;
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAppMetricsAsync(FunctionAppInfo app, TimeRange timeRange, CancellationToken cancellationToken)
    {
        try
        {
            // Get all metrics for this app in one query
            var appMetrics = await MetricsService.GetAppMetricsAsync(app, timeRange, cancellationToken);
            
            // Map metrics to functions by short name and load recent invocations
            foreach (var function in app.Functions)
            {
                var shortName = GetShortFunctionName(function.Name);
                if (appMetrics.TryGetValue(shortName, out var metrics))
                {
                    function.Metrics = metrics;
                }
                else
                {
                    function.Metrics = new FunctionMetrics();
                }

                // Load recent invocations (limit to 20 for health check)
                try
                {
                    var invocations = await MetricsService.GetInvocationsAsync(
                        app.AppInsightsResourceId ?? string.Empty,
                        function.Name,
                        timeRange,
                        cancellationToken);
                    function.RecentInvocations = invocations.Take(20).ToList();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load invocations for {FunctionName}", function.Name);
                    function.RecentInvocations = new List<FunctionInvocation>();
                }
            }
            
            appsLoadingMetrics.Remove(app.ResourceId);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load metrics for app {AppName}", app.Name);
            appsLoadingMetrics.Remove(app.ResourceId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadResourceGroupsAsync(bool showLoadingState = true)
    {
        if (showLoadingState)
        {
            isDiscovering = true;
        }

        errorMessage = null;
        
        if (showLoadingState)
        {
            await InvokeAsync(StateHasChanged);
        }

        var timeoutSeconds = AzureSettings.Value.OperationTimeoutSeconds;
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));

        try
        {
            availableResourceGroups = await DiscoveryService.ListResourceGroupsAsync(subscriptionId, cts.Token);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load resource groups: {ex.Message}";
        }
        finally
        {
            if (showLoadingState)
            {
                isDiscovering = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnSubscriptionChanged(ChangeEventArgs e)
    {
        var newSubscriptionId = e.Value?.ToString();
        if (string.IsNullOrEmpty(newSubscriptionId) || newSubscriptionId == subscriptionId)
            return;

        subscriptionId = newSubscriptionId;
        resourceGroup = string.Empty; // Reset resource group when subscription changes
        availableResourceGroups.Clear();
        functionApps.Clear();
        showRefreshPrompt = false;
        DashboardState.ClearRefreshPrompt();
        
        await LoadResourceGroupsAsync(showLoadingState: true);
    }

    private async Task OnResourceGroupChanged(ChangeEventArgs e)
    {
        var newResourceGroup = e.Value?.ToString();
        if (string.IsNullOrEmpty(newResourceGroup) || newResourceGroup == resourceGroup)
            return;

        resourceGroup = newResourceGroup;
        showRefreshPrompt = false;
        DashboardState.ClearRefreshPrompt();
        functionApps.Clear(); // Clear old data
        await LoadDataAsync();
    }

    private void ViewFunctionDetails(FunctionAppInfo app, FunctionInfo function)
    {
        DashboardState.Capture(subscriptionId, resourceGroup, selectedTimeRange, availableResourceGroups, functionApps);
        Navigation.NavigateTo(FunctionDetailsNavigation.BuildUri(app, function));
    }

    private Task RefreshDataAsync()
    {
        return LoadDataAsync();
    }

    private async Task RefreshSingleAppAsync(FunctionAppInfo app)
    {
        if (appsLoadingMetrics.Contains(app.ResourceId))
        {
            return;
        }

        appsLoadingMetrics.Add(app.ResourceId);
        await InvokeAsync(StateHasChanged);

        var timeoutSeconds = AzureSettings.Value.OperationTimeoutSeconds;
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));

        try
        {
            await LoadAppMetricsAsync(app, selectedTimeRange, cts.Token);

            if (canManageApps)
            {
                try
                {
                    var state = await ManagementService.GetStateAsync(app.ResourceId);
                    appStates[app.ResourceId] = state;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to get state for app {AppName}", app.Name);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Refresh operation timed out for app {AppName}", app.Name);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh app {AppName}", app.Name);
        }
    }

    private static string GetShortFunctionName(string fullName)
    {
        // Extract short name from full path (e.g., "resource-name/function-name" -> "function-name")
        var lastSlashIndex = fullName.LastIndexOf('/');
        return lastSlashIndex >= 0 ? fullName.Substring(lastSlashIndex + 1) : fullName;
    }

    private async Task CheckManagementPermissionsAsync()
    {
        if (string.IsNullOrEmpty(subscriptionId) || string.IsNullOrEmpty(resourceGroup))
        {
            canManageApps = false;
            return;
        }

        try
        {
            canManageApps = await ManagementService.CanManageAsync(subscriptionId, resourceGroup);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check management permissions");
            canManageApps = false;
        }
    }

    private async Task LoadAppStatesAsync()
    {
        if (!canManageApps)
        {
            return;
        }

        var tasks = functionApps.Select(async app =>
        {
            try
            {
                var state = await ManagementService.GetStateAsync(app.ResourceId);
                appStates[app.ResourceId] = state;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to get state for app {AppName}", app.Name);
                appStates[app.ResourceId] = FunctionAppState.Unknown;
            }
        });

        await Task.WhenAll(tasks);
    }

    private async Task StartAppAsync(FunctionAppInfo app)
    {
        await ManageAppLifecycleAsync(app, async () =>
        {
            await ManagementService.StartAsync(app.ResourceId);
            appStates[app.ResourceId] = FunctionAppState.Running;
        }, "start");
    }

    private async Task StopAppAsync(FunctionAppInfo app)
    {
        await ManageAppLifecycleAsync(app, async () =>
        {
            await ManagementService.StopAsync(app.ResourceId);
            appStates[app.ResourceId] = FunctionAppState.Stopped;
        }, "stop");
    }

    private async Task RestartAppAsync(FunctionAppInfo app)
    {
        await ManageAppLifecycleAsync(app, async () =>
        {
            await ManagementService.RestartAsync(app.ResourceId);
            appStates[app.ResourceId] = FunctionAppState.Running;
        }, "restart");
    }

    private async Task ManageAppLifecycleAsync(FunctionAppInfo app, Func<Task> action, string operationName)
    {
        isManaging.Add(app.ResourceId);
        managementErrorMessage = null;
        StateHasChanged();

        try
        {
            await action();
        }
        catch (UnauthorizedAccessException ex)
        {
            managementErrorMessage = $"Permission denied: {ex.Message}";
            errorMessage = managementErrorMessage;
        }
        catch (Exception ex)
        {
            managementErrorMessage = $"Failed to {operationName} {app.Name}: {ex.Message}";
            errorMessage = managementErrorMessage;
        }
        finally
        {
            isManaging.Remove(app.ResourceId);
            StateHasChanged();
        }
    }

    private static string GetStateBadgeClass(FunctionAppState state) => state switch
    {
        FunctionAppState.Running => "bg-success",
        FunctionAppState.Stopped => "bg-secondary",
        FunctionAppState.Starting => "bg-info",
        FunctionAppState.Stopping => "bg-warning",
        _ => "bg-light text-dark"
    };
}

