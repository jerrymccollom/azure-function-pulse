@page "/"
@rendermode InteractiveServer
@using FuncPulse.Core.Models
@using FuncPulse.Core.Services
@using Microsoft.Extensions.Options
@inject IFunctionDiscoveryService DiscoveryService
@inject IMetricsService MetricsService
@inject IOptions<AzureSettings> AzureSettings
@inject NavigationManager Navigation

<PageTitle>FuncPulse - Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>FuncPulse Dashboard</h1>
            @if (AzureSettings.Value.DemoMode)
            {
                <div class="alert alert-info">
                    <strong>Demo Mode:</strong> Showing sample data. Configure Azure credentials to view real functions.
                </div>
            }
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Subscription</h6>
                    <p class="card-text">@(string.IsNullOrEmpty(subscriptionId) ? "Not configured" : subscriptionId)</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Resource Group</h6>
                    <p class="card-text">@(string.IsNullOrEmpty(resourceGroup) ? "Not configured" : resourceGroup)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label class="form-label">Time Range</label>
            <div class="btn-group" role="group">
                @foreach (var range in Enum.GetValues<TimeRange>())
                {
                    <button type="button" 
                            class="btn @(selectedTimeRange == range ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SelectTimeRange(range)">
                        @range.ToDisplayString()
                    </button>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-overlay">
            <div class="loading-content">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="mt-3">Loading Function Apps...</h4>
                <p class="text-muted">Connecting to Azure and discovering functions</p>
                <p class="text-muted small">This may take 30-60 seconds if authenticating for the first time</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="white-space: pre-line;">
            <strong>Error:</strong> @errorMessage
        </div>
    }
    else if (functionApps.Count == 0)
    {
        <div class="alert alert-warning">
            No function apps found in the configured resource group.
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">@functionApps.Count</h5>
                        <p class="card-text text-muted">Function Apps</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">@totalFunctions</h5>
                        <p class="card-text text-muted">Total Functions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5 class="card-title">@healthyCount</h5>
                        <p class="card-text">Healthy</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body">
                        <h5 class="card-title">@unhealthyCount</h5>
                        <p class="card-text">Needs Attention</p>
                    </div>
                </div>
            </div>
        </div>

        @foreach (var app in functionApps)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5>@app.Name <span class="badge bg-secondary">@app.Location</span></h5>
                </div>
                <div class="card-body">
                    @if (app.Functions.Count == 0)
                    {
                        <p class="text-muted">No functions found</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Function</th>
                                        <th>Trigger</th>
                                        <th>Status</th>
                                        <th>Invocations</th>
                                        <th>Success Rate</th>
                                        <th>Failures</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var function in app.Functions)
                                    {
                                        var metrics = function.Metrics;
                                        var status = metrics?.GetHealthStatus() ?? HealthStatus.Unknown;
                                        var statusClass = status switch
                                        {
                                            HealthStatus.Healthy => "success",
                                            HealthStatus.Warning => "warning",
                                            HealthStatus.Critical => "danger",
                                            _ => "secondary"
                                        };

                                        <tr>
                                            <td>@function.Name</td>
                                            <td><span class="badge bg-info">@function.TriggerType</span></td>
                                            <td><span class="badge bg-@statusClass">@status</span></td>
                                            <td>@(metrics?.TotalCount ?? 0)</td>
                                            <td>
                                                @if (metrics != null && metrics.TotalCount > 0)
                                                {
                                                    @($"{(100 - metrics.FailureRate):F1}%")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (metrics != null && metrics.FailureCount > 0)
                                                {
                                                    <span class="badge bg-danger">@metrics.FailureCount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => ViewFunctionDetails(app, function)">
                                                    Details
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string subscriptionId = string.Empty;
    private string resourceGroup = string.Empty;
    private TimeRange selectedTimeRange = TimeRange.Hours24;
    private List<FunctionAppInfo> functionApps = new();
    private bool isLoading = true;
    private string? errorMessage;
    
    private int totalFunctions => functionApps.Sum(a => a.Functions.Count);
    private int healthyCount => functionApps.SelectMany(a => a.Functions)
        .Count(f => f.Metrics?.GetHealthStatus() == HealthStatus.Healthy);
    private int unhealthyCount => functionApps.SelectMany(a => a.Functions)
        .Count(f => {
            var status = f.Metrics?.GetHealthStatus();
            return status == HealthStatus.Warning || status == HealthStatus.Critical;
        });

    protected override async Task OnInitializedAsync()
    {
        subscriptionId = AzureSettings.Value.SubscriptionId;
        resourceGroup = AzureSettings.Value.ResourceGroup;
        
        if (AzureSettings.Value.DemoMode || 
            (!string.IsNullOrEmpty(subscriptionId) && !string.IsNullOrEmpty(resourceGroup)))
        {
            await LoadDataAsync();
        }
        else
        {
            isLoading = false;
            errorMessage = "Azure subscription and resource group not configured. Update appsettings.json or environment variables.";
        }
    }

    private async Task SelectTimeRange(TimeRange range)
    {
        selectedTimeRange = range;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        // Add timeout protection
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));

        try
        {
            functionApps = await DiscoveryService.DiscoverFunctionAppsAsync(
                subscriptionId, 
                resourceGroup, 
                cts.Token);
            
            foreach (var app in functionApps)
            {
                foreach (var function in app.Functions)
                {
                    // Check if cancelled before each metrics call
                    cts.Token.ThrowIfCancellationRequested();
                    
                    function.Metrics = await MetricsService.GetFunctionMetricsAsync(
                        app.ResourceId, 
                        function.Name, 
                        selectedTimeRange,
                        cts.Token);
                }
            }
        }
        catch (OperationCanceledException)
        {
            var timestamp = DateTime.Now.ToString("HH:mm:ss");
            Console.WriteLine($"[{timestamp}] FunctionDiscoveryService: TIMEOUT after 60 seconds");
            Console.WriteLine($"[{timestamp}] FunctionDiscoveryService: This usually indicates slow authentication or network issues");
            errorMessage = "Operation timed out after 60 seconds. This usually means:\n" +
                          "• Azure CLI authentication is slow or stale (try: az login --use-device-code)\n" +
                          "• Network connectivity issues to Azure\n" +
                          "• Insufficient permissions on the subscription/resource group\n" +
                          "Check the console output for details on where the operation stalled.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load function apps: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ViewFunctionDetails(FunctionAppInfo app, FunctionInfo function)
    {
        Navigation.NavigateTo($"/function/{Uri.EscapeDataString(app.Name)}/{Uri.EscapeDataString(function.Name)}");
    }
}

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.95);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-content {
        text-align: center;
        padding: 2rem;
    }

    .loading-content h4 {
        color: #333;
        margin-top: 1rem;
    }

    .loading-content p {
        color: #666;
    }
</style>
