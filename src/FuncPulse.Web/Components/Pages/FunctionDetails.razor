@page "/function/{appName}/{functionName}"
@rendermode InteractiveServer
@using FuncPulse.Core.Models
@using FuncPulse.Core.Services
@using FuncPulse.Web.Services
@using static FuncPulse.Web.Services.TimeDisplayMode
@inject IMetricsService MetricsService
@inject ILogsService LogsService
@inject NavigationManager Navigation
@inject DashboardState DashboardState

<PageTitle>@FunctionName - FuncPulse</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item">@AppName</li>
                    <li class="breadcrumb-item active">@GetShortFunctionName(FunctionName)</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <h2>@GetShortFunctionName(FunctionName)</h2>
            <p class="text-muted">Function App: @AppName</p>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-outline-secondary" @onclick="BackToDashboard">
                Back to Dashboard
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Time Range</label>
            <div class="btn-group" role="group">
                @foreach (var range in Enum.GetValues<TimeRange>())
                {
                    <button type="button" 
                            class="btn @(selectedTimeRange == range ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SelectTimeRange(range)">
                        @range.ToDisplayString()
                    </button>
                }
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Time Display</label>
            <div class="btn-group" role="group">
                <button type="button" 
                        class="btn @(DashboardState.TimeDisplayMode == TimeDisplayMode.Local ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetTimeDisplayMode(TimeDisplayMode.Local)">
                    Local
                </button>
                <button type="button" 
                        class="btn @(DashboardState.TimeDisplayMode == TimeDisplayMode.Utc ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetTimeDisplayMode(TimeDisplayMode.Utc)">
                    UTC
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (invocations.Count == 0)
    {
        <div class="alert alert-info">
            No invocations found for the selected time range.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>Recent Invocations</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Status</th>
                                <th>Duration</th>
                                <th>Result Code</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invocation in invocations.Take(100))
                            {
                                <tr>
                                    <td>@DashboardState.FormatDateTime(invocation.Timestamp) @DashboardState.GetTimeZoneLabel()</td>
                                    <td>
                                        @if (invocation.Success)
                                        {
                                            <span class="badge bg-success">Success</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                    </td>
                                    <td>@invocation.Duration.TotalMilliseconds.ToString("F0") ms</td>
                                    <td>@invocation.ResultCode</td>
                                    <td>
                                        @if (!invocation.Success)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ViewLogs(invocation)">
                                                View Logs
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (selectedInvocation != null)
        {
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5>Failed Invocation Logs</h5>
                    <button type="button" class="btn-close btn-close-white float-end" @onclick="ClearLogs"></button>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Operation ID</dt>
                        <dd class="col-sm-9"><code>@selectedInvocation.OperationId</code></dd>
                        
                        <dt class="col-sm-3">Timestamp</dt>
                        <dd class="col-sm-9">@DashboardState.FormatDateTime(selectedInvocation.Timestamp) @DashboardState.GetTimeZoneLabel()</dd>
                        
                        <dt class="col-sm-3">Duration</dt>
                        <dd class="col-sm-9">@selectedInvocation.Duration.TotalMilliseconds.ToString("F0") ms</dd>
                        
                        @if (!string.IsNullOrEmpty(selectedInvocation.ExceptionMessage))
                        {
                            <dt class="col-sm-3">Exception</dt>
                            <dd class="col-sm-9"><span class="text-danger">@selectedInvocation.ExceptionMessage</span></dd>
                        }
                    </dl>

                    @if (loadingLogs)
                    {
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading logs...</span>
                            </div>
                            <span class="ms-2">Loading logs...</span>
                        </div>
                    }
                    else if (invocationLog != null && invocationLog.Entries.Count > 0)
                    {
                        <h6 class="mt-3">Log Entries</h6>
                        <div class="log-viewer">
                            @foreach (var entry in invocationLog.Entries)
                            {
                                <div class="log-entry log-level-@entry.Level.ToLower()">
                                    <span class="log-timestamp">@DashboardState.FormatDateTime(entry.Timestamp, "HH:mm:ss.fff")</span>
                                    <span class="badge bg-@GetLogLevelBadgeClass(entry.Level)">@entry.Level</span>
                                    <span class="log-message">@entry.Message</span>
                                    
                                    @if (!string.IsNullOrEmpty(entry.ExceptionType))
                                    {
                                        <div class="ms-4 mt-2">
                                            <strong>Exception Type:</strong> <code>@entry.ExceptionType</code>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(entry.StackTrace))
                                    {
                                        <pre class="ms-4 mt-2 text-danger"><code>@entry.StackTrace</code></pre>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(logsUnavailableMessage))
                    {
                        <div class="alert alert-warning mt-3">
                            @logsUnavailableMessage
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .log-viewer {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 1rem;
        max-height: 600px;
        overflow-y: auto;
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
    }

    .log-entry {
        padding: 0.5rem;
        margin-bottom: 0.5rem;
        border-left: 3px solid #6c757d;
        background-color: white;
    }

    .log-entry.log-level-error,
    .log-entry.log-level-critical {
        border-left-color: #dc3545;
        background-color: #fff5f5;
    }

    .log-entry.log-level-warning {
        border-left-color: #ffc107;
        background-color: #fffbf0;
    }

    .log-timestamp {
        color: #6c757d;
        margin-right: 0.5rem;
    }

    .log-message {
        color: #212529;
    }
</style>

@code {
    [Parameter]
    public string AppName { get; set; } = string.Empty;

    [Parameter]
    public string FunctionName { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = FunctionDetailsNavigation.AppInsightsResourceIdQueryParameter)]
    public string? AppInsightsResourceId { get; set; }

    private TimeRange selectedTimeRange = TimeRange.Hours24;
    private List<FunctionInvocation> invocations = new();
    private FunctionInvocation? selectedInvocation;
    private InvocationLog? invocationLog;
    private bool isLoading = true;
    private bool loadingLogs;
    private string? logsUnavailableMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvocationsAsync();
    }

    private async Task SelectTimeRange(TimeRange range)
    {
        selectedTimeRange = range;
        selectedInvocation = null;
        invocationLog = null;
        await LoadInvocationsAsync();
    }

    private void SetTimeDisplayMode(TimeDisplayMode mode)
    {
        DashboardState.TimeDisplayMode = mode;
        StateHasChanged();
    }

    private async Task LoadInvocationsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // In a real implementation, we would need the resource ID
            invocations = await MetricsService.GetInvocationsAsync(
                AppInsightsResourceId ?? string.Empty,
                FunctionName, 
                selectedTimeRange);
        }
        catch (Exception)
        {
            invocations = new List<FunctionInvocation>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewLogs(FunctionInvocation invocation)
    {
        selectedInvocation = invocation;
        invocationLog = null;
        loadingLogs = true;
        logsUnavailableMessage = null;
        StateHasChanged();

        try
        {
            // In a real implementation, we would need the App Insights resource ID
            invocationLog = await LogsService.GetInvocationLogsAsync(
                AppInsightsResourceId ?? string.Empty,
                invocation.OperationId);

            if (invocationLog == null || invocationLog.Entries.Count == 0)
            {
                logsUnavailableMessage = "Logs unavailable - Application Insights not configured or no logs found for this invocation.";
            }
        }
        catch (Exception)
        {
            logsUnavailableMessage = "Failed to load logs. Application Insights may not be configured.";
        }
        finally
        {
            loadingLogs = false;
            StateHasChanged();
        }
    }

    private void ClearLogs()
    {
        selectedInvocation = null;
        invocationLog = null;
        logsUnavailableMessage = null;
    }

    private void BackToDashboard()
    {
        Navigation.NavigateTo("/");
    }

    private string GetLogLevelBadgeClass(string level) => level switch
    {
        "Error" or "Critical" => "danger",
        "Warning" => "warning",
        "Information" => "info",
        _ => "secondary"
    };

    private static string GetShortFunctionName(string fullName)
    {
        // Extract short name from full path (e.g., "resource-name/function-name" -> "function-name")
        var lastSlashIndex = fullName.LastIndexOf('/');
        return lastSlashIndex >= 0 ? fullName.Substring(lastSlashIndex + 1) : fullName;
    }
}
