@page "/function/{appName}/{functionName}"
@rendermode InteractiveServer
@using FuncPulse.Core.Models
@using FuncPulse.Core.Services
@using FuncPulse.Web.Services
@using static FuncPulse.Web.Services.TimeDisplayMode
@inject IMetricsService MetricsService
@inject ILogsService LogsService
@inject NavigationManager Navigation
@inject DashboardState DashboardState
@inject IFunctionManagementService ManagementService
@inject ILogger<FunctionDetails> Logger

<PageTitle>@FunctionName - FuncPulse</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item">@AppName</li>
                    <li class="breadcrumb-item active">@GetShortFunctionName(FunctionName)</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <h2>@GetShortFunctionName(FunctionName)</h2>
            <p class="text-muted">Function App: @AppName</p>
        </div>
        <div class="col-auto d-flex gap-2">
            @if (canManageFunction)
            {
                <button type="button" 
                        class="btn @(isFunctionEnabled ? "btn-outline-warning" : "btn-outline-success")"
                        @onclick="ToggleFunctionStateAsync"
                        disabled="@isManagingFunction">
                    @if (isManagingFunction)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-@(isFunctionEnabled ? "stop-circle" : "play-circle") me-1"></i>
                    }
                    @(isFunctionEnabled ? "Disable" : "Enable") Function
                </button>
            }
            else if (!string.IsNullOrEmpty(AppInsightsResourceId))
            {
                <button type="button" 
                        class="btn btn-outline-secondary" 
                        disabled
                        title="Insufficient permissions to manage functions">
                    <i class="bi bi-lock"></i> Management Disabled
                </button>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="BackToDashboard">
                Back to Dashboard
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">Time Range</label>
            <div class="btn-group" role="group">
                @foreach (var range in Enum.GetValues<TimeRange>())
                {
                    <button type="button" 
                            class="btn @(selectedTimeRange == range ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SelectTimeRange(range)">
                        @range.ToDisplayString()
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label">Time Display</label>
            <div class="btn-group" role="group">
                <button type="button" 
                        class="btn @(DashboardState.TimeDisplayMode == TimeDisplayMode.Local ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetTimeDisplayMode(TimeDisplayMode.Local)">
                    Local
                </button>
                <button type="button" 
                        class="btn @(DashboardState.TimeDisplayMode == TimeDisplayMode.Utc ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetTimeDisplayMode(TimeDisplayMode.Utc)">
                    UTC
                </button>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="button" 
                    class="btn btn-outline-primary ms-auto"
                    @onclick="RefreshDataAsync"
                    disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (invocations.Count == 0)
    {
        <div class="alert alert-info">
            No invocations found for the selected time range.
        </div>
    }
    else
    {
        <div class="row g-3 align-items-start">
            <div class="@(selectedInvocation != null ? "col-12 col-xl-5" : "col-12")">
                <div class="card mb-3 mb-xl-0">
                    <div class="card-header">
                        <h5>Recent Invocations</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive @(selectedInvocation != null ? "invocation-list-scroll" : string.Empty)">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Status</th>
                                        <th>Duration</th>
                                        <th>Result Code</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invocation in PagedInvocations)
                                    {
                                        <tr class="@(selectedInvocation?.OperationId == invocation.OperationId ? "table-active" : null)">
                                            <td>@DashboardState.FormatDateTime(invocation.Timestamp) @DashboardState.GetTimeZoneLabel()</td>
                                            <td>
                                                @if (invocation.Success)
                                                {
                                                    <span class="badge bg-success">Success</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                            <td>@invocation.Duration.TotalMilliseconds.ToString("F0") ms</td>
                                            <td>@invocation.ResultCode</td>
                                            <td>
                                                <button class="btn btn-sm @(selectedInvocation?.OperationId == invocation.OperationId ? (invocation.Success ? "btn-primary" : "btn-danger") : (invocation.Success ? "btn-outline-primary" : "btn-outline-danger"))"
                                                        @onclick="() => ViewLogs(invocation)">
                                                    View Logs
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (TotalPages > 1)
                        {
                            <nav class="mt-3" aria-label="Invocations pagination">
                                <ul class="pagination pagination-sm justify-content-center mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">Previous</button>
                                    </li>
                                    @for (int i = 1; i <= TotalPages; i++)
                                    {
                                        var pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                        </li>
                                    }
                                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == TotalPages)">Next</button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>

            @if (selectedInvocation != null)
            {
                <div class="col-12 col-xl-7">
                    <div class="card invocation-logs-card">
                        <div class="card-header @(selectedInvocation.Success ? "bg-success" : "bg-danger") text-white">
                            <h5>@(selectedInvocation.Success ? "Successful" : "Failed") Invocation Logs</h5>
                            <button type="button" class="btn-close btn-close-white float-end" @onclick="ClearLogs"></button>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">Operation ID</dt>
                                <dd class="col-sm-9"><code>@selectedInvocation.OperationId</code></dd>
                                
                                <dt class="col-sm-3">Timestamp</dt>
                                <dd class="col-sm-9">@DashboardState.FormatDateTime(selectedInvocation.Timestamp) @DashboardState.GetTimeZoneLabel()</dd>
                                
                                <dt class="col-sm-3">Duration</dt>
                                <dd class="col-sm-9">@selectedInvocation.Duration.TotalMilliseconds.ToString("F0") ms</dd>
                                
                                @if (!string.IsNullOrEmpty(selectedInvocation.ExceptionMessage))
                                {
                                    <dt class="col-sm-3">Exception</dt>
                                    <dd class="col-sm-9"><span class="text-danger">@selectedInvocation.ExceptionMessage</span></dd>
                                }
                            </dl>

                            @if (loadingLogs)
                            {
                                <div class="text-center">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading logs...</span>
                                    </div>
                                    <span class="ms-2">Loading logs...</span>
                                </div>
                            }
                            else if (invocationLog != null && invocationLog.Entries.Count > 0)
                            {
                                <h6 class="mt-3">Log Entries</h6>
                                <div class="log-viewer">
                                    @foreach (var entry in invocationLog.Entries)
                                    {
                                        <div class="log-entry log-level-@entry.Level.ToLower()">
                                            <span class="log-timestamp">@DashboardState.FormatDateTime(entry.Timestamp, "yyyy-MM-dd HH:mm:ss.fff") @DashboardState.GetTimeZoneLabel()</span>
                                            <span class="badge bg-@GetLogLevelBadgeClass(entry.Level)">@entry.Level</span>
                                            <span class="log-message">@entry.Message</span>
                                            
                                            @if (!string.IsNullOrEmpty(entry.ExceptionType))
                                            {
                                                <div class="ms-4 mt-2">
                                                    <strong>Exception Type:</strong> <code>@entry.ExceptionType</code>
                                                </div>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(entry.StackTrace))
                                            {
                                                <pre class="ms-4 mt-2 text-danger"><code>@entry.StackTrace</code></pre>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(logsUnavailableMessage))
                            {
                                <div class="alert alert-warning mt-3">
                                    @logsUnavailableMessage
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .invocation-list-scroll {
        max-height: 70vh;
        overflow-y: auto;
    }

    .invocation-logs-card {
        position: sticky;
        top: 1rem;
    }

    .log-viewer {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 1rem;
        max-height: 600px;
        overflow-y: auto;
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
    }

    .log-entry {
        padding: 0.5rem;
        margin-bottom: 0.5rem;
        border-left: 3px solid #6c757d;
        background-color: white;
        overflow-wrap: anywhere;
    }

    .log-entry.log-level-error,
    .log-entry.log-level-critical {
        border-left-color: #dc3545;
        background-color: #fff5f5;
    }

    .log-entry.log-level-warning {
        border-left-color: #ffc107;
        background-color: #fffbf0;
    }

    .log-timestamp {
        color: #6c757d;
        margin-right: 0.5rem;
    }

    .log-message {
        color: #212529;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .log-entry pre {
        white-space: pre-wrap;
        word-break: break-word;
        overflow-x: auto;
    }

    @@media (max-width: 1199.98px) {
        .invocation-list-scroll {
            max-height: none;
        }

        .invocation-logs-card {
            position: static;
        }
    }
</style>

@code {
    [Parameter]
    public string AppName { get; set; } = string.Empty;

    [Parameter]
    public string FunctionName { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = FunctionDetailsNavigation.AppInsightsResourceIdQueryParameter)]
    public string? AppInsightsResourceId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = FunctionDetailsNavigation.AppResourceIdQueryParameter)]
    public string? AppResourceId { get; set; }

    private TimeRange selectedTimeRange = TimeRange.Hours24;
    private List<FunctionInvocation> invocations = new();
    private FunctionInvocation? selectedInvocation;
    private InvocationLog? invocationLog;
    private bool isLoading = true;
    private bool loadingLogs;
    private string? logsUnavailableMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int TotalPages => (int)Math.Ceiling((double)invocations.Count / PageSize);
    private List<FunctionInvocation> PagedInvocations => invocations.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    private bool canManageFunction;
    private bool isFunctionEnabled = true;
    private bool isManagingFunction;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvocationsAsync();
        
        if (!string.IsNullOrEmpty(AppResourceId))
        {
            await CheckFunctionManagementPermissionsAsync();
        }
    }

    private async Task SelectTimeRange(TimeRange range)
    {
        selectedTimeRange = range;
        selectedInvocation = null;
        invocationLog = null;
        currentPage = 1;
        await LoadInvocationsAsync();
    }

    private void SetTimeDisplayMode(TimeDisplayMode mode)
    {
        DashboardState.TimeDisplayMode = mode;
        StateHasChanged();
    }

    private async Task LoadInvocationsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // In a real implementation, we would need the resource ID
            invocations = await MetricsService.GetInvocationsAsync(
                AppInsightsResourceId ?? string.Empty,
                FunctionName, 
                selectedTimeRange);
        }
        catch (Exception)
        {
            invocations = new List<FunctionInvocation>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDataAsync()
    {
        // Clear any selected invocation and logs when refreshing
        selectedInvocation = null;
        invocationLog = null;
        logsUnavailableMessage = null;
        currentPage = 1;
        
        await LoadInvocationsAsync();
    }

    private async Task ViewLogs(FunctionInvocation invocation)
    {
        selectedInvocation = invocation;
        invocationLog = null;
        loadingLogs = true;
        logsUnavailableMessage = null;
        StateHasChanged();

        try
        {
            // In a real implementation, we would need the App Insights resource ID
            invocationLog = await LogsService.GetInvocationLogsAsync(
                AppInsightsResourceId ?? string.Empty,
                invocation.OperationId);

            if (invocationLog == null || invocationLog.Entries.Count == 0)
            {
                logsUnavailableMessage = "Logs unavailable - Application Insights not configured or no logs found for this invocation.";
            }
        }
        catch (Exception)
        {
            logsUnavailableMessage = "Failed to load logs. Application Insights may not be configured.";
        }
        finally
        {
            loadingLogs = false;
            StateHasChanged();
        }
    }

    private void ClearLogs()
    {
        selectedInvocation = null;
        invocationLog = null;
        logsUnavailableMessage = null;
    }

    private void BackToDashboard()
    {
        Navigation.NavigateTo("/");
    }

    private string GetLogLevelBadgeClass(string level) => level switch
    {
        "Error" or "Critical" => "danger",
        "Warning" => "warning",
        "Information" => "info",
        _ => "secondary"
    };

    private static string GetShortFunctionName(string fullName)
    {
        // Extract short name from full path (e.g., "resource-name/function-name" -> "function-name")
        var lastSlashIndex = fullName.LastIndexOf('/');
        return lastSlashIndex >= 0 ? fullName.Substring(lastSlashIndex + 1) : fullName;
    }

    private void ChangePage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > TotalPages)
            return;
        
        currentPage = pageNumber;
        StateHasChanged();
    }

    private async Task CheckFunctionManagementPermissionsAsync()
    {
        if (string.IsNullOrEmpty(AppResourceId))
        {
            canManageFunction = false;
            return;
        }

        try
        {
            isFunctionEnabled = await ManagementService.IsFunctionEnabledAsync(AppResourceId, FunctionName);
            canManageFunction = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check function management permissions");
            canManageFunction = false;
        }
    }

    private async Task ToggleFunctionStateAsync()
    {
        if (string.IsNullOrEmpty(AppResourceId))
            return;

        isManagingFunction = true;
        StateHasChanged();

        try
        {
            if (isFunctionEnabled)
            {
                await ManagementService.DisableFunctionAsync(AppResourceId, FunctionName);
                isFunctionEnabled = false;
            }
            else
            {
                await ManagementService.EnableFunctionAsync(AppResourceId, FunctionName);
                isFunctionEnabled = true;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Permission denied when toggling function state");
            canManageFunction = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle function state");
        }
        finally
        {
            isManagingFunction = false;
            StateHasChanged();
        }
    }
}
